# Project-local Kaggle credentials. Copy to .env (gitignored) and paste the token.
# Deleting .env and .kaggle-local/ removes every credential trace from the machine.
#
#   uv run --env-file .env kaggle ...      (uv does not auto-load .env)
#
# Do NOT run `kaggle auth login`: the OAuth flow writes ~/.kaggle/credentials.json
# via a hardcoded expanduser(), which KAGGLE_CONFIG_DIR does not redirect.

# Required even though nothing is read from it: importing the kaggle module runs
# os.makedirs() on this path, and would otherwise create ~/.kaggle.
KAGGLE_CONFIG_DIR=C:/Users/Programador/personal/multibus-headway-forecast/.kaggle-local

# kaggle.com/settings -> API -> Create New Token. Token only; no username needed.
KAGGLE_API_TOKEN=
